APP_ENV=development
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator
DATABASE_URL_SYNC=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator_test
DEMO_MODE=true
SYNC_BALANCE_SECONDS=60
SYNC_POSITION_SECONDS=15
SYNC_HISTORY_SECONDS=300
SYNC_CLOSED_POSITION_SECONDS=600
SYNC_HEALTH_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12
EXCHANGE_ACCOUNTS_CONFIG=/app/config/exchange_accounts.json

# Host-level PostgreSQL backups (optional overrides).
# BACKUP_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/exchange_aggregator
# BACKUP_DIR=/var/backups/aggregated-accounts
# BACKUP_RETENTION_DAYS=14
# BACKUP_VERIFY_RESTORE=1

# Exchange account secrets referenced by backend/config/exchange_accounts.json.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
HYPERLIQUID_WALLET_ADDRESS=
POLYMARKET_WALLET_ADDRESS=
