APP_ENV=development
APP_ENCRYPTION_KEY=
COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator
DATABASE_URL_SYNC=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@host.docker.internal:5432/exchange_aggregator_test
DEMO_MODE=true
SYNC_BALANCE_SECONDS=60
SYNC_POSITION_SECONDS=15
SYNC_HISTORY_SECONDS=300
SYNC_CLOSED_POSITION_SECONDS=600
SYNC_HEALTH_SECONDS=60
# Set either value to 0 to disable that database cleanup permanently.
SYNC_JOB_RETENTION_DAYS=30
BALANCE_SNAPSHOT_RETENTION_DAYS=90
EQUITY_CURVE_CACHE_SECONDS=30
MAINTENANCE_HOUR_UTC=4
MAINTENANCE_MINUTE_UTC=20
REQUEST_TIMEOUT_SECONDS=12
EXCHANGE_ACCOUNTS_CONFIG=/app/config/exchange_accounts.json

# Host-level PostgreSQL backups (optional overrides).
# BACKUP_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/exchange_aggregator
# BACKUP_DIR=/var/backups/aggregated-accounts
# BACKUP_RETENTION_DAYS=90
# BACKUP_VERIFY_RESTORE=1

# Host-level read-only daily health check and Feishu delivery.
# Keep the real webhook URL only in the untracked production .env.
FEISHU_HEALTH_WEBHOOK_URL=
HEALTH_CHECK_PUBLIC_URL=https://assets.example.com
HEALTH_CHECK_WARNING_DISK_PERCENT=80
HEALTH_CHECK_CRITICAL_DISK_PERCENT=90

# Exchange account secrets referenced by backend/config/exchange_accounts.json.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
HYPERLIQUID_WALLET_ADDRESS=
POLYMARKET_WALLET_ADDRESS=

# Server-side Polymarket market-title translation via Baidu LLM translation.
# Keep real credentials in the untracked production .env only.
BAIDU_TRANSLATION_ENABLED=false
BAIDU_TRANSLATION_APPID=
BAIDU_TRANSLATION_API_KEY=
BAIDU_TRANSLATION_ENDPOINT=https://fanyi-api.baidu.com/ait/api/aiTextTranslate
BAIDU_TRANSLATION_TIMEOUT_SECONDS=20
BAIDU_TRANSLATION_BATCH_SIZE=20
